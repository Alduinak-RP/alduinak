# HTTP server
# Port the Express backend listens on.
PORT=4000

# WebSocket relay
# Port for the in-game chat WebSocket relay.
WS_PORT=7778
# Shared secret between the relay and the gamemode.
RELAY_SECRET=replace-with-a-strong-random-secret

# Game server connection
# IP / hostname of the game server (for status checks and metrics proxy).
SKYMP_HOST=127.0.0.1

# IP for the public, set this to your server's public IP
SERVER_ADDRESS=

# The game server's name, port, player cap, offline mode, master key, master
# URL, master API token, metrics login and access rules (lock, whitelist and
# ban roles) are read from its server-settings.json (SERVER_SETTINGS_PATH,
# default build/dist/server/server-settings.json); there is nothing to copy here.
# Optional short label shown in the launcher (e.g. "Roleplay", "PvP").
# SERVER_GAMEMODE=Roleplay

# Optional test server (docs/docs_test_server.md): listed when
# testserver/server-settings.json (or TEST_SERVER_SETTINGS_PATH) exists with a
# masterKey of its own and ports clear of the live server. It may read live
# backend state but every write is refused.
# TEST_SERVER_SETTINGS_PATH=

# Launch sanity check
# When true (default), the game server refuses connections from clients whose
# launcher did not verify current client files + load order right before
# launching. Set to false while players are still on launcher builds that
# predate the check.
LAUNCH_CHECK_ENFORCE=true

# Discord OAuth
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI registered in the Discord application (must match exactly).
# DISCORD_REDIRECT_URI=https://your-backend.example.com/api/users/login-discord/callback
# Rich Presence application id sent to launchers (/api/serverinfo discordAppId); unset keeps the launcher's built-in id.
# DISCORD_PRESENCE_APP_ID=

DISCORD_BOT_TOKEN=your_bot_token_here
# Snowflake ID of the Discord server (guild) to check member roles in - not a token.
DISCORD_GUILD_ID=your_discord_server_id_here

# Admin dashboard (Discord OAuth)
# Standalone dashboard server. Point a subdomain at this port/service.
DASHBOARD_PORT=4002
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
# Public API base used by the dashboard browser app.
DASHBOARD_API_BASE_URL=https://api.example.com
# Separate redirect URI for the admin dashboard OAuth flow.
# Must be added to the Discord app's OAuth2 redirect list.
# DISCORD_DASHBOARD_REDIRECT_URI=https://your-backend.example.com/auth/dashboard/callback
# Comma-separated list of Discord user IDs allowed to access the admin dashboard.
DASHBOARD_DISCORD_IDS=
# Public URL of the website, used to redirect back after dashboard OAuth.
WEBSITE_URL=https://your-website.example.com
# Web Server Manager (dashboard Server tab), see docs/docs_web_server_manager.md.
# Loopback port of the AlduinakManager agent service (server-manager/Setup-Agent.bat).
MANAGER_AGENT_PORT=4003
# Shared secret the backend signs agent calls with; at least 32 characters, e.g. the
# output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left empty the manager stays off: the agent refuses every call.
MANAGER_AGENT_SECRET=
# Folder for web jobs, their logs, the busy lock and the audit files (default C:\logs\manager).
# MANAGER_LOG_DIR=C:\logs\manager
# Optional Discord webhook of a private staff channel that mirrors manager actions and failed logins.
# MANAGER_AUDIT_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Daily game restart by the agent at this local HH:MM, with in-game warnings from 1 hour
# before and the logs archived (default 04:00, read live); off disables it.
# AUTO_RESTART_AT=04:00

# Whitelist fallback: with no whitelistRoleId in the server's access block,
# data/whitelist.json (a JSON array of Discord ids) limits who may join when non-empty.
# The whitelist and banned roles may not hold a privileged permission (admin.*, manager.*, permissions.manage, server.access.manage, factions.define); the bot refuses to assign such a role.

