{
  "name": "alduinak-launcher",
  "version": "2.4.3",
  "description": "Launcher for the Alduinak server",
  "productName": "Alduinak Launcher",
  "main": "src/main.js",
  "author": "F02K and Suraru",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "electron": "41.2.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.alduinak.launcher",
    "productName": "Alduinak Launcher",
    "directories": {
      "output": "../build/launcher"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/7zip/**",
      "!assets/xdelta/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/7zip",
        "to": "7zip"
      },
      {
        "from": "assets/xdelta",
        "to": "xdelta"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "AlduinakLauncher.exe",
      "include": "installer.nsh"
    }
  }
}
